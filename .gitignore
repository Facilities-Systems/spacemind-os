# ═══════════════════════════════════════════════════════════════
#  SpaceMind OS — .gitignore
# ═══════════════════════════════════════════════════════════════

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
*.spec

# ── Virtual environments ─────────────────────────────────────────
.venv/
venv/
env/
.env/
ENV/

# ── Environment & secrets ────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.cert
*.crt
secrets/

# ── Node.js / npm ────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# ── Frontend build output ─────────────────────────────────────────
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.cache/
*.tsbuildinfo

# ── IDE ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.sw?
.history/

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────
logs/
*.log
log/

# ── Database files ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── ChromaDB (vector store) ───────────────────────────────────────
chroma_data/
chroma/
.chroma/

# ── Testing & coverage ───────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/

# ── Type checking ────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# ── Docker (local overrides) ─────────────────────────────────────
.docker/
docker-compose.override.yml

# ── Uploads & generated files ────────────────────────────────────
uploads/
exports/
generated/
*.pdf
*.xlsx
data/raw/
data/processed/

# ── Monitoring / observability ───────────────────────────────────
.sentry/
sentry.properties

# ── Misc ─────────────────────────────────────────────────────────
.temp/
.tmp/
tmp/
temp/
*.bak
*.orig
*.rej
.cache/
