# ─── SpaceMind OS — Environment Configuration ────────────────────────────────

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# App
APP_ENV=development        # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL preferred; SQLite used in dev if not set)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/spacemind
# DATABASE_URL=sqlite+aiosqlite:///./spacemind.db

# AI Model config
PRIMARY_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# Feature flags
ENABLE_HISTORY=true
ENABLE_VECTOR_MEMORY=false   # Phase 2

# Rate limiting
DECOMPOSE_RATE_LIMIT=10/minute
