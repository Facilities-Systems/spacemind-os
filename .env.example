# ─── SpaceMind OS — Environment Configuration ────────────────────────────────

# Anthropic / Claude
ANTHROPIC_API_KEY="sk-ant-api03-YOUR_KEY_HERE"

# App
APP_ENV=development        # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL preferred; SQLite used in dev if not set)
# Railway provides a managed PostgreSQL — copy the DATABASE_URL from the Railway dashboard
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/spacemind
# DATABASE_URL=sqlite:///./data/spacemind.db   # local dev fallback

# AI Model config
PRIMARY_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# Feature flags
ENABLE_HISTORY=true
ENABLE_VECTOR_MEMORY=false   # Phase 2 — requires chromadb installed
ENABLE_MULTI_AGENT=false     # Phase 2 — parallel specialist AI agents

# CORS origins (comma-separated — production only, dev uses localhost defaults)
# Set to your Railway frontend URL: https://spacemind-os-frontend.railway.app
CORS_ORIGINS=https://spacemind-os-frontend.railway.app

# Rate limiting
DECOMPOSE_RATE_LIMIT=10/minute

# Observability
SENTRY_DSN=                # Leave blank to disable Sentry (backend)
VITE_SENTRY_DSN=           # Leave blank to disable Sentry (frontend)
PROMETHEUS_ENABLED=false   # Railway has built-in metrics

# Auth (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Railway deployment ───────────────────────────────────────────────────────
# Single-service deployment: React SPA is built into the Python image (root Dockerfile).
# FastAPI serves both /api/v1/* and the React app — one URL, no proxy needed.
#
# GitHub repository secrets (not in this file):
#   RAILWAY_TOKEN     — project token: Railway dashboard → Settings → Tokens
#
# GitHub repository variables:
#   RAILWAY_APP_URL   — e.g. https://spacemind-os.railway.app  (for health check)
#
# Railway service variables (set in Railway dashboard):
#   ANTHROPIC_API_KEY, SECRET_KEY, DATABASE_URL, APP_ENV=production
#   CORS_ORIGINS=https://<your-service>.railway.app
#   STATIC_DIR=/app/static   (already set in Dockerfile ENV, here for reference)
